%-------------------------------------------------------------------------------
% resumestyle.sty -- page layout, colours and section macros for resume.tex
%
% Derived from the academic-resume-latex template by Ran Cheng, itself adapted
% from Indu Dwivedi and Sourabh Bajaj. See LICENSE for terms.
%-------------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resumestyle}[2026/07/26 Resume layout and section macros]

% --- Packages -----------------------------------------------------------------
\RequirePackage[empty]{fullpage}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
% OT1 is listed LAST, which makes it the document default -- exactly what it was
% before T5 was added here, so no body text reflows. T5 is Vietnamese; it is
% loaded only so \vnname below can borrow it. Reordering these breaks that.
\RequirePackage[T5,OT1]{fontenc}
\RequirePackage[charter]{mathdesign}  % Bitstream Charter
\RequirePackage{graphicx}
\RequirePackage{multirow}
\RequirePackage{xcolor}
\RequirePackage{CJKutf8}              % before hyperref
\RequirePackage[hidelinks]{hyperref}  % load last

% --- Page furniture -----------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% --- Margins ------------------------------------------------------------------
\addtolength{\oddsidemargin}{-0.50in}
\addtolength{\evensidemargin}{-0.50in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

% --- Colours ------------------------------------------------------------------
% linkblue was RGB(111,153,222), which measures 2.88:1 against white and fails
% the WCAG AA 4.5:1 threshold -- a problem when a whole certificate title is the
% anchor. This value measures 6.93:1. titleblue is 4.90:1 and is left alone.
\definecolor{linkblue}{RGB}{31, 90, 160}
\definecolor{titleblue}{RGB}{46, 116, 181}
\urlstyle{same}

% hyperref is loaded with [hidelinks], so a bare \href prints in body black.
% Every link in this document must go through \resumeLink -- otherwise it is
% invisible as a link, which is what happened to the header's site and ORCID.
\newcommand{\resumeLink}[2]{\href{#1}{\textcolor{linkblue}{#2}}}

% --- Names --------------------------------------------------------------------
% The same person is bylined three ways across this document's sources: the
% publications say Hung-Jen Tu, the identifiers say danghoangnhan, and ORCID
% still says Daniel Du. These two macros are the non-ASCII halves of that; see
% sections/names.tex for the prose that ties them together.
%
% Both are defined here rather than inline because each needs a font the body
% text does not use, and getting either wrong fails silently -- the glyph still
% renders, it just extracts as garbage.

% Vietnamese name. The document default is OT1, which has neither D-bar nor the
% two-diacritic vowels, so this borrows T5 (the Vietnamese encoding) and the
% vntex Charter family -- the same Bitstream Charter as the body text, so it is
% visually seamless.
%
% Do NOT build these glyphs from accent commands instead. \d{\u a} renders an
% acceptable-looking ặ, but \d is an \oalign overlay, so the PDF holds three
% separate glyphs and pdftotext returns "a˘." -- an ATS, or anyone copying the
% name out, gets mojibake. T5 has one precomposed glyph per character with a
% correct ToUnicode map, which is the entire reason it is worth loading.
\newcommand{\vnname}{{\fontencoding{T5}\fontfamily{bch}\selectfont Đặng Hoàng Nhân}}

% Legal name in Traditional Chinese. pdfLaTeX ships no CJK font; CJKutf8 pulls
% in Arphic bsmi (AR PL Mingti2L Big5, a Ming/serif face) for these three glyphs
% only, so every Latin metric in this document is untouched.
%
% \upshape is not cosmetic: there is no italic Ming face, so using this inside
% an \textit{} group -- which sections/names.tex does -- otherwise emits
% "Font shape C70/bsmi/m/it undefined". Upright is also the correct rendering;
% Chinese has no italic form.
%
% Do NOT reach for XeLaTeX/LuaLaTeX to get CJK. fontspec re-selects the body
% font and reflows the whole document, and CI asserts this layout to the page.
\newcommand{\cjkname}{\begin{CJK}{UTF8}{bsmi}\upshape 杜弘仁\end{CJK}}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% --- Section headings ---------------------------------------------------------
\titleformat{\section}{
  \vspace{-6pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% Tightened, coloured section heading. Use this rather than \section directly.
\newcommand{\resumeSection}[1]{\vspace{-10pt}\section{\textcolor{titleblue}{#1}}}

% --- Entry macros -------------------------------------------------------------
\newcommand{\resumeItem}[2]{
  \item\small{
    \textbf{#1}{: #2 \vspace{-2pt}}
  }
}

\newcommand{\resumeItemNoBullet}[2]{
  \item[]\small{
    \hspace{-9pt}\textbf{#1}{: #2 \vspace{-6pt}}
  }
}

% Employer / location on the first line, role / dates on the second.
% The ampersands here are tabular column separators -- they must NOT be escaped.
\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt}\item[]
  \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
      \hspace{-10pt}\textbf{#1} & #2 \\
      \hspace{-10pt}\textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubItem}[2]{\resumeItem{#1}{#2}\vspace{-4pt}}

\renewcommand{\labelitemii}{$\circ$}

% --- List macros --------------------------------------------------------------
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=*]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

% Sub-bullets inside a \resumeItem body. Always use this pair rather than a bare
% \begin{itemize}: hand-rolling the environment inside a macro argument is what
% produced the mis-nested \end{itemize} that broke earlier revisions.
\newcommand{\resumeNestedListStart}{\begin{itemize}}
\newcommand{\resumeNestedListEnd}{\end{itemize}}
